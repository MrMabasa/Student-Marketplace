{
  "name": "student-marketplace-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the StudentMarketplace2 Android application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/runMigrations.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.5.0",
    "multer": "^2.5.0",
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
