<?xml version="1.0" encoding="utf-8"?>

<!-- Allows the registration form to scroll on smaller screens. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Holds all registration fields vertically. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Registration heading. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Student Account"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Student's full name. -->
        <EditText
            android:id="@+id/etRegisterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:autofillHints="name" />

        <!-- Student's email address. -->
        <EditText
            android:id="@+id/etRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Student email address"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:layout_marginTop="12dp" />

        <!-- Student number for the verification process. -->
        <EditText
            android:id="@+id/etStudentNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Student number"
            android:inputType="text"
            android:autofillHints="username"
            android:layout_marginTop="12dp" />

        <!-- Lets the student select an institution from the dropdown. -->
        <AutoCompleteTextView
            android:id="@+id/etInstitution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="Select your institution"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <!-- Appears only when Other / Not Listed is selected. -->
        <EditText
            android:id="@+id/etCustomInstitution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Enter your institution name"
            android:inputType="textCapWords"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <!-- Password field with a built-in visibility toggle. -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:endIconMode="password_toggle">

            <!-- Accepts the new account password. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Create password"
                android:inputType="textPassword"
                android:autofillHints="newPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password confirmation field with its own visibility toggle. -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:endIconMode="password_toggle">

            <!-- Confirms the password entered above. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="Confirm password"
                android:inputType="textPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Yellow secondary button for new student registration. -->
        <Button
            android:id="@+id/btnRegister"
            style="@style/StudentMarketplace.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Create Account"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
