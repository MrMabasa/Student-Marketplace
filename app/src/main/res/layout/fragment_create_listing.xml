<?xml version="1.0" encoding="utf-8"?>

<!-- Makes the listing form scrollable on smaller devices. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <!-- Holds the listing information fields vertically. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Main screen heading. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a Listing"
            android:textColor="@color/brand_navy"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Explains what the student should enter. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the details of the item you want to sell."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- Captures the name of the item being sold. -->
        <EditText
            android:id="@+id/etListingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="Item title"
            android:inputType="textCapSentences" />

        <!-- Captures the item's category. -->
        <AutoCompleteTextView
            android:id="@+id/etListingCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="Select item category"
            android:inputType="none"
            android:focusable="true"
            android:clickable="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <!-- Captures the selling price in South African rand. -->
        <EditText
            android:id="@+id/etListingPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="Price (R)"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <!-- Captures the condition of the item. -->
        <AutoCompleteTextView
            android:id="@+id/etListingCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="Select item condition"
            android:inputType="none"
            android:focusable="true"
            android:clickable="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <!-- Captures an optional module code. -->
        <EditText
            android:id="@+id/etModuleCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="@color/brand_blue"
            android:hint="Module code (optional)"
            android:inputType="textCapCharacters"
            android:layout_marginTop="12dp" />

        <!-- Captures a longer description of the item. -->
        <EditText
            android:id="@+id/etListingDescription"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:padding="12dp"
            android:gravity="top"
            android:backgroundTint="@color/brand_blue"
            android:hint="Describe your item"
            android:inputType="textCapSentences|textMultiLine"
            android:layout_marginTop="12dp" />
        <!-- Opens the future item photo selection feature. -->
        <Button
            android:id="@+id/btnAddListingPhoto"
            style="@style/StudentMarketplace.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="Add Item Photo"
            android:layout_marginTop="20dp" />
        <!-- Previews the photo selected by the student. -->
        <ImageView
            android:id="@+id/ivListingPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="Selected listing photo"
            android:visibility="gone" />
        <!-- Publishes the listing once saving functionality is implemented. -->
        <Button
            android:id="@+id/btnSubmitListing"
            style="@style/StudentMarketplace.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="Publish Listing"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>