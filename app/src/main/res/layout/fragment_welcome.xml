<?xml version="1.0" encoding="utf-8"?>

<!-- Vertical layout for the app's welcome screen. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Main app heading. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Marketplace"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Brief description of the marketplace. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buy and sell with fellow students."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Primary blue button for existing students. -->
    <Button
        android:id="@+id/btnWelcomeSignIn"
        style="@style/StudentMarketplace.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Sign In" />

    <!-- Button that opens the registration screen. -->
    <!-- Yellow secondary button for new students. -->
    <Button
        android:id="@+id/btnWelcomeRegister"
        style="@style/StudentMarketplace.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Create Account"
        android:layout_marginTop="12dp" />

</LinearLayout>