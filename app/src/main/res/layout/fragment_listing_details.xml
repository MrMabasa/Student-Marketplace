<?xml version="1.0" encoding="utf-8"?>

<!-- Allows listing details to scroll on smaller screens. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <!-- Arranges the selected item's information vertically. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Main screen heading. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listing Details"
            android:textColor="@color/brand_navy"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Displays the marketplace item's photograph. -->
        <ImageView
            android:id="@+id/ivListingImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:contentDescription="Marketplace item photograph"
            android:scaleType="centerCrop"
            android:background="@color/border_light" />

        <!-- Displays the item name. -->
        <TextView
            android:id="@+id/tvListingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Introduction to Programming"
            android:textColor="@color/brand_navy"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- Displays the selling price. -->
        <TextView
            android:id="@+id/tvListingPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: R350"
            android:textColor="@color/brand_blue"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <!-- Displays the item's condition. -->
        <TextView
            android:id="@+id/tvListingCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Condition: Good"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <!-- Displays the item's description. -->
        <TextView
            android:id="@+id/tvListingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A useful programming textbook for students studying introductory programming."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="20dp" />

        <!-- Displays information about the seller. -->
        <TextView
            android:id="@+id/tvSellerInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seller: Verified Student"
            android:textColor="@color/brand_navy"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <!-- Provides the buyer's request action. -->
        <Button
            android:id="@+id/btnRequestItem"
            style="@style/StudentMarketplace.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="Request This Item"
            android:layout_marginTop="28dp" />

    </LinearLayout>

</ScrollView>