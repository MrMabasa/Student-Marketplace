<?xml version="1.0" encoding="utf-8"?>

<!-- Defines the app theme and reusable button styles. -->
<resources>

    <!-- Main application theme using the brand colours. -->
    <style name="Base.Theme.StudentMarketplace"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/brand_white</item>
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorOnSecondary">@color/brand_navy</item>

        <item name="android:colorBackground">@color/brand_white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>

        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
    </style>

    <!-- Active application theme. -->
    <style name="Theme.StudentMarketplace"
        parent="Base.Theme.StudentMarketplace" />

    <!-- Reusable blue primary button. -->
    <style name="StudentMarketplace.PrimaryButton"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/brand_white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Reusable yellow secondary button. -->
    <style name="StudentMarketplace.SecondaryButton"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_yellow</item>
        <item name="android:textColor">@color/brand_navy</item>
        <item name="cornerRadius">12dp</item>
    </style>

</resources>